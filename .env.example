# Copy to .env and adjust. Every value has a safe default for a local demo.
# ---------------------------------------------------------------- security
# Shared secrets between components. CHANGE THESE for any shared/multi-machine deployment.
DTQ_CLUSTER_TOKEN=change-me-cluster-token     # workers/autoscaler/API -> broker
DTQ_AGENT_TOKEN=change-me-agent-token         # autoscaler/API -> worker agent
DTQ_ADMIN_TOKEN=change-me-admin-token         # dashboard admin controls (X-Admin-Token)
DTQ_DEMO_MODE=true                            # false disables fault injection + demo reset

# ---------------------------------------------------------------- database
POSTGRES_USER=dtq
POSTGRES_PASSWORD=dtq
POSTGRES_DB=dtq

# ---------------------------------------------------------------- host ports
DTQ_HTTP_PORT=8080       # dashboard
DTQ_API_PORT=8000        # REST API + OpenAPI docs (/docs)
DTQ_BROKER_PORT=8001     # broker (remote workers connect here)
DTQ_PG_PORT=5433         # PostgreSQL, bound to 127.0.0.1 only

# ---------------------------------------------------------------- failure detection / leases
DTQ_HEARTBEAT_INTERVAL_S=2
DTQ_WORKER_SUSPECT_AFTER_S=6
DTQ_WORKER_DEAD_AFTER_S=10
DTQ_LEASE_DURATION_S=15
DTQ_ASSIGN_ACK_TIMEOUT_S=10
DTQ_RETRY_BACKOFF_BASE_S=1
DTQ_RETRY_BACKOFF_MAX_S=30

# ---------------------------------------------------------------- workers & scaling
DTQ_INITIAL_WORKERS=3
DTQ_WORKER_CAPACITY=2            # concurrent task slots per worker
DTQ_WORKER_CPUS=0                # per-worker CPU limit (0 = unlimited)
DTQ_WORKER_MEMORY_MB=768
DTQ_WORKER_GRACEFUL_TIMEOUT_S=30
DTQ_AGENT_MAX_WORKERS=12         # hard safety cap enforced by the agent
# Additional agents on other machines (comma-separated):
# DTQ_AGENT_URLS=http://agent:8003,http://192.168.1.20:8003

# ---------------------------------------------------------------- logging
DTQ_LOG_LEVEL=INFO
DTQ_LOG_FORMAT=json              # json | console
